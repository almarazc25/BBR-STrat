# Copy to `.env` for local development, or paste into Railway's Variables tab.
# Yahoo Finance is the data source now — no API keys, no OAuth.

# --- Pushover (phone notifications) ---
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
SEND_PUSHOVER=true
PRINT_TO_TERMINAL=true

# --- Engine ---
TICKERS=SPY,QQQ
NUM_EXPIRATIONS=6
STRIKE_RANGE_PCT=0.05
RISK_FREE_RATE=0.05

# --- Scheduler (long-running --serve mode) ---
RUN_TIME_ET=09:00
RUN_ON_START=false

# --- Live intraday polling (--live mode) ---
POLL_INTERVAL_MINUTES=5
LIVE_MODE_START=09:30
LIVE_MODE_END=16:00
GEX_FLIP_ALERT=true
DEX_SHIFT_PCT=0.25
LEVEL_SHIFT_STRIKES=3
