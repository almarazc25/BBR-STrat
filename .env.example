# Copy to `.env` for local development, or paste these into Railway's
# Variables tab for the deployed service.

# --- Schwab developer app ---
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# Bootstrap token (one-line JSON string from a local schwab_token.json after
# your one-time browser login). Only needed on Railway.
SCHWAB_TOKEN_JSON=

# Where the runtime stores the refreshing token. On Railway, mount a Volume
# at /data and leave this default.
# SCHWAB_TOKEN_PATH=/data/schwab_token.json

# --- Pushover ---
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
SEND_PUSHOVER=true
PRINT_TO_TERMINAL=true

# --- Engine ---
TICKERS=SPY,QQQ
NUM_EXPIRATIONS=3
STRIKE_RANGE_PCT=0.05

# --- Scheduler (long-running --serve mode) ---
RUN_TIME_ET=09:00
RUN_ON_START=false
