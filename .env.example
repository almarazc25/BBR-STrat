# Copy to `.env` for local development, or paste into Railway's Variables tab.

# --- Data source ---
# "schwab" = real-time, requires OAuth setup
# "yahoo"  = no-auth fallback (~15 min delayed)
DATA_SOURCE=schwab

# --- Schwab credentials (only if DATA_SOURCE=schwab) ---
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# Bootstrap token (one-line JSON contents from a local schwab_token.json
# after your one-time browser login). Only needed on Railway / headless.
SCHWAB_TOKEN_JSON=

# Where the runtime stores the refreshing token. On Railway, mount a
# Volume at /data and leave this default.
# SCHWAB_TOKEN_PATH=/data/schwab_token.json

# --- Pushover (phone notifications) ---
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
SEND_PUSHOVER=true
PRINT_TO_TERMINAL=true

# --- Engine ---
TICKERS=SPY,QQQ
NUM_EXPIRATIONS=3
STRIKE_RANGE_PCT=0.05
RISK_FREE_RATE=0.05

# --- Scheduler (long-running --serve mode) ---
RUN_TIME_ET=09:00
RUN_ON_START=false

# --- Live intraday polling (--live mode) ---
POLL_INTERVAL_MINUTES=5
LIVE_MODE_START=09:30
LIVE_MODE_END=16:00
GEX_FLIP_ALERT=true
DEX_SHIFT_PCT=0.25
LEVEL_SHIFT_STRIKES=3
